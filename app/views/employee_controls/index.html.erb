<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panou Angajat - YellowBloom</title>
  <%= stylesheet_link_tag 'employee_controls', media: 'all', 'data-turbo-track': 'reload' %>
</head>
<body>
  <div class="employee-dashboard">
    <main class="employee-content">

      <% if flash[:notice] %>
        <div class="section-content" style="background:#eaf7ea; border-left:4px solid #2ecc71;">
          <p><%= flash[:notice] %></p>
        </div>
      <% end %>
      <% if flash[:alert] %>
        <div class="section-content" style="background:#fdecea; border-left:4px solid #e74c3c;">
          <p><%= flash[:alert] %></p>
        </div>
      <% end %>

      <section id="sectiunea-comenzi" class="section-content">
        <h2>Comenzi</h2>
        <% if @orders.blank? %>
          <p>Nu există comenzi în așteptare.</p>
        <% else %>
          <div class="orders-list">
            <% @orders.each do |order| %>
              <div class="comanda-card">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:12px;">
                  <div>
                    <h3 style="margin:0 0 4px 0;">Comanda #<%= order.id %> — <small><%= order.created_at.strftime('%d.%m.%Y %H:%M') %></small></h3>
                    <p style="margin:0; color:#555;">Client: <%= order.user&.username || order.user&.email %> | Adresă: <%= order.address %></p>
                    <ul style="margin:6px 0 0 16px;">
                      <% order.order_items.each do |oi| %>
                        <li><%= oi.product&.name %> × <%= oi.quantity %></li>
                      <% end %>
                    </ul>
                    <p style="margin:6px 0 0 0;"><strong>Total:</strong> <%= number_with_precision(order.total, precision: 2) %> lei</p>
                  </div>
                  <div>
                    <% if order.status == 'pending' %>
                      <%= button_to 'Confirmă', employee_confirm_order_path(order), method: :patch, class: 'form-button' %>
                    <% elsif order.status == 'confirmed' %>
                      <%= button_to 'Finalizează', employee_complete_order_path(order), method: :patch, class: 'form-button' %>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </section>

      <section id="sectiunea-stocuri" class="section-content">
        <h2>Stoc ingrediente</h2>

        <div>
          <% @ingredients.each do |ing| %>
            <div class="comanda-card" style="display:flex; align-items:center; justify-content:space-between; gap:16px;">
              <div>
                <h3 style="margin:0 0 6px 0;"><%= ing.name %></h3>
                <p style="margin:0; color:#555;">Unitate: <%= ing.unit %></p>
              </div>
              <div style="display:flex; align-items:center; gap:10px;">
                <%= form_with model: ing, url: employee_ingredient_path(ing), method: :patch, local: true do |f| %>
                  <%= f.number_field :stock_quantity, step: :any, min: 0, class: "form-input", style: "width:140px;" %>
                  <button type="submit" class="form-button" style="margin-left:8px;">Actualizează</button>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <%= paginate_compact(current_page: @ingredients_page, total_pages: @ingredients_pages, param: 'ingredients_page') %>
      </section>

      <section id="sectiunea-retete" class="section-content">
        <h2>Rețete</h2>
        <div class="orders-list">
          <% @products.each do |p| %>
            <div class="comanda-card">
              <h3 style="margin:0 0 6px;"><%= p.name %> (<%= p.category %>)</h3>
              <p style="margin:0 0 6px; color:#555;">Preț: <strong><%= number_with_precision(p.price, precision: 2) %> lei</strong></p>
              <ul style="margin:0 0 0 16px;">
                <% p.product_ingredients.includes(:ingredient).each do |pi| %>
                  <li><%= pi.ingredient&.name %>: <strong><%= pi.quantity %> <%= pi.ingredient&.unit %></strong></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </div>
        <%= paginate_compact(current_page: @recipes_page, total_pages: @recipes_pages, param: 'recipes_page') %>
      </section>

      <%# Secțiunea Pisici eliminată conform cerinței %>

      <section id="sectiunea-mese" class="section-content">
        <h2>Mese</h2>
        <div class="reservations-board">
          <div class="reservations-col">
            <% @dining_tables.each do |t| %>
              <div class="masa-card" data-table-id="<%= t.id %>" data-controller="reservations-board" data-reservations-board-target="table" data-action="dragover->reservations-board#allowDrop drop->reservations-board#dropOnTable">
                <h3>Masa <%= t.name %></h3>
                <p>Locuri: <%= t.seats %></p>
                <p><strong>Rezervări:</strong></p>
                <ul>
                  <% t.reservations.where(status: 'assigned').order(:starts_at).each do |r| %>
                    <li>
                      <%= r.starts_at.strftime('%d.%m %H:%M') %> - <%= (r.starts_at + r.duration_minutes.minutes).strftime('%H:%M') %> | <%= r.user&.username || r.user&.email %> ( <%= r.seats %> )
                      <%= button_to 'Finalizat', employee_complete_reservation_path(r), method: :patch, form: { class: 'inline-form' }, class: 'form-button ml-8' %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>

          <div class="reservations-col">
            <div class="mesaj-card">
              <h3>Cereri rezervări</h3>
              <% if @reservation_requests.blank? %>
                <p>Nu există cereri în așteptare.</p>
              <% else %>
                <ul id="reservation-requests">
                  <% @reservation_requests.each do |r| %>
                    <li draggable="true" data-controller="reservations-board" data-reservations-board-reservation-id-value="<%= r.id %>" data-action="dragstart->reservations-board#dragStart" class="reservation-request-item">
                      <strong>#<%= r.id %></strong> — <%= r.starts_at.strftime('%d.%m %H:%M') %> | Locuri: <%= r.seats %> | <%= r.user&.username || r.user&.email %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>
</body>
</html>
