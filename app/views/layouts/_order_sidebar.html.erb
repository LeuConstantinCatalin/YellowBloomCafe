<head>
  <%= stylesheet_link_tag 'order_sidebar', media: 'all', 'data-turbo-track': 'reload' %>
</head>
<aside class="sidebar" data-controller="order" data-order-state-value="idle">
  <h2>Comenzi și Rezervări</h2>

  <div class="sidebar-info">
    <h3 class="sidebar-subtitle">Cum plasezi o comandă</h3>
    <ul class="sidebar-steps">
      <li>Deschide secțiunea „Comenzi” cu butonul „+”.</li>
      <li>Apasă „Pornește modul comandă” și adaugă produse din meniu.</li>
      <li>Verifică totalul și completează adresa dacă este necesar.</li>
      <li>Apasă „Finalizează comanda”.</li>
    </ul>

    <h3 class="sidebar-subtitle" style="margin-top:10px;">Cum faci o rezervare</h3>
    <ul class="sidebar-steps">
      <li>Deschide secțiunea „Rezervări” cu butonul „+”.</li>
      <li>Completează ziua, ora și numărul de locuri.</li>
      <li>Apasă „Trimite cererea”.</li>
      <li>Vei primi confirmarea și, dacă e cazul, masa asignată.</li>
    </ul>
  </div>

  <!-- Orders section (expand to view form + list) -->
  <div class="sb-card">
    <div class="sb-header">
      <strong>Comenzi</strong>
      <button type="button" class="btn sb-toggle-btn" data-action="click->order#toggleSection">+</button>
    </div>
    <div class="sb-content">
      <div class="order-controls">
        <button type="button" class="btn" data-action="click->order#toggleMode" data-order-target="toggleBtn">
          Pornește modul comandă
        </button>
      </div>
      <div class="cart" data-order-target="cart">
        <h3>Coș</h3>
        <div data-order-target="cartItems" class="cart-items"></div>
        <div class="cart-total">
          Total: <strong><span data-order-target="total">0</span> lei</strong>
        </div>

        <% if current_user && current_user.adresa.blank? %>
          <div class="address-block" data-order-target="addressBlock">
            <label for="checkout-address">Adresă livrare</label>
            <input id="checkout-address" type="text" class="form-input" placeholder="Introdu adresa ta" data-order-target="addressInput" />
          </div>
        <% else %>
          <div class="address-block--info">
            <small>
              Adresă curentă: <%= current_user&.adresa.presence || '-' %>
            </small>
          </div>
        <% end %>

        <div class="cart-actions">
          <button type="button" class="btn btn-primary" data-action="click->order#checkout" data-order-target="checkoutBtn" disabled>
            Finalizează comanda
          </button>
          <button type="button" class="btn btn-secondary" data-action="click->order#clearCart">
            Golește coșul
          </button>
        </div>
        <div class="cart-feedback" data-order-target="feedback"></div>
      </div>

      <div class="my-orders-scroll" style="margin-top:10px;">
        <% if defined?(@my_orders) && @my_orders.present? %>
          <% @my_orders.each do |order| %>
            <div class="order-card">
              <div class="order-card-head">
                <strong>#<%= order.id %></strong>
                <small><%= order.created_at.strftime('%d.%m.%Y %H:%M') %></small>
              </div>
              <div class="order-card-status">
                <% case order.status
                   when 'pending' %>
                     <span>Comandă plasată</span>
                <%   when 'confirmed' %>
                     <span>Comandă confirmată</span>
                <%   when 'completed' %>
                     <span>Comandă finalizată</span>
                <%   when 'cancelled' %>
                     <span>Comandă anulată</span>
                <% end %>
              </div>
              <ul class="order-items">
                <% order.order_items.each do |oi| %>
                  <li><%= oi.product&.name %> × <%= oi.quantity %></li>
                <% end %>
              </ul>
              <div class="order-card-total">
                <strong><%= number_with_precision(order.total, precision: 2) %> lei</strong>
              </div>
            </div>
          <% end %>
        <% else %>
          <p>Nu ai comenzi încă.</p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="sb-card">
    <div class="sb-header">
      <strong>Rezervări</strong>
      <button type="button" class="btn sb-toggle-btn" data-action="click->order#toggleSection">+</button>
    </div>
    <div class="sb-content">
      <% if current_user %>
        <div class="reservation-block">
          <form data-controller="reservation-form" data-action="submit->reservation-form#submit">
            <div class="row">
              <label>Ziua</label>
              <input type="date" required data-reservation-form-target="date" />
            </div>
            <div class="row">
              <label>Ora</label>
              <input type="time" required data-reservation-form-target="time" />
            </div>
            <div class="row">
              <label>Locuri</label>
              <input type="number" min="1" max="20" value="2" required data-reservation-form-target="seats" />
            </div>
            <button type="submit" class="btn" style="width:100%">Trimite cererea</button>
            <div class="cart-feedback" data-reservation-form-target="feedback"></div>
          </form>
        </div>
      <% end %>

      <div class="my-orders-scroll" style="margin-top:10px;">
        <% if defined?(@my_reservations) && @my_reservations.present? %>
          <% @my_reservations.each do |r| %>
            <div class="order-card">
              <div class="order-card-head">
                <strong>#<%= r.id %></strong>
                <small><%= r.starts_at.strftime('%d.%m.%Y %H:%M') %></small>
              </div>
              <div class="order-card-status">
                <% case r.status
                   when 'requested' %>
                     <span>Cerere trimisă</span>
                <%   when 'assigned' %>
                     <span>Rezervare asignată <%= r.dining_table ? "(Masa #{r.dining_table.name})" : '' %></span>
                <%   when 'completed' %>
                     <span>Rezervare finalizată</span>
                <%   when 'cancelled' %>
                     <span>Rezervare anulată</span>
                <% end %>
              </div>
              <ul class="order-items">
                <li>Locuri: <%= r.seats %></li>
                <% if r.dining_table %>
                  <li>Masa: <%= r.dining_table.name %></li>
                <% end %>
                <li>Interval: <%= r.starts_at.strftime('%H:%M') %> - <%= (r.starts_at + r.duration_minutes.minutes).strftime('%H:%M') %></li>
              </ul>
            </div>
          <% end %>
        <% else %>
          <p>Nu ai rezervări încă.</p>
        <% end %>
      </div>
    </div>
  </div>

  <%# Toggling is handled in app/javascript/controllers/order_controller.js (order#toggleSection) %>
</aside>
