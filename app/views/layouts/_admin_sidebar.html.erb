<head>
  <%= stylesheet_link_tag 'employee_sidebar', media: 'all', 'data-turbo-track': 'reload' %>
</head>
<aside class="employee-sidebar">
  <h2>Panou Admin</h2>
  <ul>
    <li><a href="#sectiunea-statistici">Statistici site</a></li>
    <li><a href="#sectiunea-utilizatori">Creare conturi</a></li>
    <% if current_user %>
      <li>
        <form method="post" action="<%= logout_path %>">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <button type="submit" class="form-button" style="width:100%">Deconectare</button>
        </form>
      </li>
    <% end %>
  </ul>
</aside>
