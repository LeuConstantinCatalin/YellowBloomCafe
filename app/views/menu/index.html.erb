<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meniu</title>
  <%= stylesheet_link_tag 'menu', media: 'all', 'data-turbo-track': 'reload' %>
</head>
<body>
  <div class="menu-page">
    <% if @products_by_category.blank? %>
      <p>Nu există produse în meniu încă.</p>
    <% end %>

    <% @products_by_category&.each do |category, products| %>
      <div class="menu-section card collapsible">
        <div class="menu-header">
          <strong><%= category %></strong>
          <button class="toggle-btn" onclick="toggleSection(this)">≡</button>
        </div>
        <div class="menu-content">
          <ul>
            <% products.each do |p| %>
              <li id="product-<%= p.id %>" data-available="<%= p.available? %>" data-name="<%= p.name.to_s.downcase %>">
                <div class="product">
                  <div class="product-info">
                    <strong class="product-name"><%= p.name %></strong>
                    <em class="product-ingredients"><%= p.ingredient_list %></em>
                    <div>
                      <span class="product-price"><%= number_with_precision(p.price || 0, precision: 0) %> lei</span>
                      <% unless p.available? %>
                        <span class="product-status unavailable">indisponibil</span>
                      <% end %>
                    </div>
                  </div>
                  <div class="product-placeholder">
                    <%= image_tag(image_for_category(p.category), alt: p.name, loading: 'lazy') %>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
  </div>

  <script>
    function toggleSection(button) {
      const content = button.closest('.menu-section').querySelector('.menu-content');
      const isOpen = content.classList.contains('open');
      content.classList.toggle('open');
      button.textContent = isOpen ? '≡' : '≡';
      if (!isOpen) {
        content.style.maxHeight = content.scrollHeight + 'px';
      } else {
        content.style.maxHeight = '0';
      }
    }
  </script>
</body>
</html>
