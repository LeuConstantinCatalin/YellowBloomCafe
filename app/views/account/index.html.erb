<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cont - Logare/Inregistrare</title>
  <%= stylesheet_link_tag 'account', media: 'all', 'data-turbo-track': 'reload' %>
</head>
<body>
  <div class="form-container">

    <% if current_user %>
      <div id="user-info" class="form-section" style="display: block;">
        <h2>Detalii cont</h2>

        <% if flash[:notice] %>
          <div class="form-group"><p><%= flash[:notice] %></p></div>
        <% end %>

        <% if @update_errors.present? %>
          <div class="form-group">
            <p style="color:#c00; margin:0;">
              <%= @update_errors.join(', ') %>
            </p>
          </div>
        <% end %>

        <%= form_with model: current_user, url: account_path, method: :patch, local: true, id: "account-edit-form" do |f| %>
          <div class="form-group">
            <%= f.label :username, "Username" %>
            <%= f.text_field :username, class: "form-input", required: true, disabled: true, data: { editable: true } %>
          </div>
          <div class="form-group">
            <%= f.label :nume, "Nume" %>
            <%= f.text_field :nume, class: "form-input", required: true, disabled: true, data: { editable: true } %>
          </div>
          <div class="form-group">
            <%= f.label :prenume, "Prenume" %>
            <%= f.text_field :prenume, class: "form-input", required: true, disabled: true, data: { editable: true } %>
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" class="form-input" value="<%= current_user.email %>" disabled>
          </div>
          <div class="form-group">
            <%= f.label :data_nastere, "Data nasterii" %>
            <%= f.date_field :data_nastere, class: "form-input", required: true, disabled: true, data: { editable: true } %>
          </div>
          <div class="form-group">
            <%= f.label :adresa, "Adresa" %>
            <%= f.text_field :adresa, class: "form-input", disabled: true, data: { editable: true } %>
          </div>
          <button type="button" id="edit-save-btn" class="form-button" onclick="toggleEditSave()">Editeaza</button>

          <button type="submit" class="form-button">Salveaza schimbarile</button>
        <% end %>

        <form method="post" action="<%= logout_path %>">
          <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
          <button type="submit" class="form-button" style="margin-top:10px;">Deconectare</button>
        </form>
        <button type="button" class="form-button" style="margin-top:10px; background-color:#c0392b;" onclick="showDeleteConfirm()">Sterge contul</button>

        <div id="delete-confirm" class="form-section confirm-section" style="display:none;">
          <h2>Stergere cont</h2>
          <p>Esti sigur ca vrei sa iti stergi contul? Aceasta actiune este ireversibila.</p>
          <%= form_with url: account_path, method: :delete, local: true do |f| %>
            <button type="submit" class="form-button" style="background-color:#c0392b;">Confirma stergerea</button>
          <% end %>
          <button type="button" class="form-button" onclick="hideDeleteConfirm()" style="margin-top:10px;">Anuleaza</button>
        </div>
      </div>
    <% else %>

      <div class="form-tabs">
        <button class="tab-button active" onclick="showForm('login')">Logare</button>
        <button class="tab-button" onclick="showForm('signup')">Inregistrare</button>
      </div>

      <div id="login-form" class="form-section">
        <h2>Logare</h2>
        <%= form_with(url: account_path, method: :post, local: true) do |f| %>
          <div class="form-group">
            <%= f.label :email, "Email:" %>
            <%= f.email_field :email, id: "login-email", class: "form-input", required: true %>
          </div>
          <div class="form-group">
            <%= f.label :password, "Parola:" %>
            <%= f.password_field :password, id: "login-password", class: "form-input", required: true %>
          </div>
          <button type="submit" class="form-button">Logare</button>
        <% end %>
      </div>

      <div id="signup-form" class="form-section" style="display: none;">
        <h2>Inregistrare</h2>
        <%= form_with(model: @user || User.new, local: true) do |f| %>
          <div class="form-group">
            <%= f.label :username, "Username:" %>
            <%= f.text_field :username, id: "signup-username", class: "form-input", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :nume, "Nume:" %>
            <%= f.text_field :nume, id: "signup-nume", class: "form-input", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :prenume, "Prenume:" %>
            <%= f.text_field :prenume, id: "signup-prenume", class: "form-input", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :data_nastere, "Data nasterii:" %>
            <%= f.date_field :data_nastere, id: "signup-data-nastere", class: "form-input", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :email, "Email:" %>
            <%= f.email_field :email, id: "signup-email", class: "form-input", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :password, "Parola:" %>
            <%= f.password_field :password, id: "signup-password", class: "form-input", required: true %>
          </div>

          <div class="form-group">
            <%= f.label :password_confirmation, "Confirma parola:" %>
            <%= f.password_field :password_confirmation, id: "signup-confirm-password", class: "form-input", required: true %>
          </div>

          <%= f.submit "Inregistrare", class: "form-button" %>
        <% end %>
      </div>

      <% if @error_message %>
        <div class="error-message"><%= @error_message %></div>
      <% end %>

      <% if @success_message %>
        <div class="success-message"><%= @success_message %></div>
      <% end %>

    <% end %>

  </div>

  <script>
    function showForm(formType) {
      if (formType === 'login') {
        document.getElementById('login-form').style.display = 'block';
        document.getElementById('signup-form').style.display = 'none';
        document.querySelector('.tab-button.active').classList.remove('active');
        document.querySelector('.tab-button:nth-child(1)').classList.add('active');
      } else {
        document.getElementById('login-form').style.display = 'none';
        document.getElementById('signup-form').style.display = 'block';
        document.querySelector('.tab-button.active').classList.remove('active');
        document.querySelector('.tab-button:nth-child(2)').classList.add('active');
      }
    }

    // Edit/Save toggle for account details
    let isEditing = false;
    function toggleEditSave() {
      const form = document.getElementById('account-edit-form');
      const btn = document.getElementById('edit-save-btn');
      const submitButtons = form.querySelectorAll('button[type="submit"], input[type="submit"]');
      const editableInputs = form.querySelectorAll('[data-editable="true"]');

      if (!isEditing) {
        editableInputs.forEach(el => el.disabled = false);
        // Hide actual submit buttons if any (we submit programmatically)
        submitButtons.forEach(el => el.style.display = 'none');
        btn.textContent = 'Salveaza';
        isEditing = true;
      } else {
        form.submit();
      }
    }

    function showDeleteConfirm() {
      const box = document.getElementById('delete-confirm');
      box.style.display = 'block';
      box.classList.add('show');
    }
    function hideDeleteConfirm() {
      const box = document.getElementById('delete-confirm');
      box.style.display = 'none';
      box.classList.remove('show');
    }

    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('account-edit-form');
      if (form) {
        const submitButtons = form.querySelectorAll('button[type="submit"], input[type="submit"]');
        submitButtons.forEach(el => el.style.display = 'none');
      }
    });
    document.addEventListener('turbo:load', function() {
      const form = document.getElementById('account-edit-form');
      if (form) {
        const submitButtons = form.querySelectorAll('button[type="submit"], input[type="submit"]');
        submitButtons.forEach(el => el.style.display = 'none');
      }
    });
  </script>
</body>
</html>



