<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Galerie</title>
  <%= stylesheet_link_tag 'gallery', media: 'all', 'data-turbo-track': 'reload' %>
</head>
<body>
  <div class="galerie-page">
    <% ["Exterior", "Interior", "Pisici"].each do |sectiune| %>
      <div class="galerie-section card collapsible">
        <div class="galerie-header">
          <strong><%= sectiune %></strong>
          <button class="toggle-btn" onclick="toggleSection(this)">▼</button>
        </div>
        <% preview_images = case sectiune
           when 'Exterior' then Array.new(3, 'Exterior.png')
           when 'Interior' then Array.new(3, 'Interior.png')
           when 'Pisici'   then %w[Pisica1.jpg Pisica2.jpg Pisica3.jpg]
           else []
           end %>
        <div class="galerie-preview">
          <% preview_images.each do |img| %>
            <div class="preview-box"><%= image_tag img, alt: "#{sectiune} preview", loading: 'lazy' %></div>
          <% end %>
        </div>
        <% grid_images = (sectiune == 'Pisici' ? %w[Pisica1.jpg Pisica2.jpg Pisica3.jpg] : ["#{sectiune}.png"]) %>
        <div class="galerie-content">
          <% 6.times do |i| %>
            <div class="galerie-image"><%= image_tag grid_images[i % grid_images.length], alt: "#{sectiune} #{i+1}", loading: 'lazy' %></div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <script>
 function toggleSection(button) {
  const section = button.closest('.galerie-section');
  const content = section.querySelector('.galerie-content');
  const isOpen = content.classList.contains('open');

  content.classList.toggle('open');
  section.classList.toggle('open');
  button.textContent = isOpen ? '▼' : '▲';
  content.style.maxHeight = isOpen ? '0' : content.scrollHeight + 'px';
}
</script>
</body>
</html>
